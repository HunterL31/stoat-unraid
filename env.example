# =============================================================================
# STOAT CHAT - UNRAID CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your settings
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Your domain name (e.g., chat.example.com)
# -----------------------------------------------------------------------------
STOAT_DOMAIN=chat.example.com

# -----------------------------------------------------------------------------
# PATHS: Unraid appdata location
# -----------------------------------------------------------------------------
# Default Unraid appdata path - change if using a different location
APPDATA_PATH=/mnt/user/appdata

# -----------------------------------------------------------------------------
# PORTS: HTTP/HTTPS ports for Caddy reverse proxy
# -----------------------------------------------------------------------------
# Change these if you're using a separate reverse proxy (like SWAG/NPM)
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# SECURITY: Service credentials
# -----------------------------------------------------------------------------
# RabbitMQ credentials
RABBITMQ_USER=rabbituser
RABBITMQ_PASS=rabbitpass

# MinIO (S3-compatible storage) credentials
MINIO_USER=minioautumn
MINIO_PASS=minioautumn

# -----------------------------------------------------------------------------
# OPTIONAL: Advanced settings
# -----------------------------------------------------------------------------
# Set to true to make your instance invite-only
# INVITE_ONLY=false

# Tenor API key for GIF search (optional)
# TENOR_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: Discord-Revolt Bridge (revcord)
# -----------------------------------------------------------------------------
# Uncomment and configure ALL 4 variables below to enable the Discord-Revolt bridge
# Get Discord bot token from: https://discord.com/developers/applications
# Get Revolt bot token from Revolt settings -> My Bots -> Create a bot
# 
# REVCORD_DISCORD_TOKEN=
# REVCORD_REVOLT_TOKEN=
# REVCORD_API_URL=https://stoat/api
# REVCORD_REVOLT_ATTACHMENT_URL=https://stoat/autumn

# -----------------------------------------------------------------------------
# GENERATED: These are auto-generated by setup-unraid.sh
# Do not modify manually unless you know what you're doing
# -----------------------------------------------------------------------------
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# FILES_ENCRYPTION_KEY=

